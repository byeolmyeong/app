# 변수 이름만 적는다. 값은 .env 에 두고 .env 는 커밋하지 않는다.
# 서버 주소(끝에 / 없이). 예: 로컬 서버 주소
EXPO_PUBLIC_API_URL=
# 1 이면 서버를 부르지 않고 src/lib/fixtures 의 응답 예시로 답한다(개발용)
EXPO_PUBLIC_USE_FIXTURES=
# 1 이면 앱이 켜질 때 POST /auth/dev 로 개발용 세션을 받는다(개발용, 운영 빌드에는 켜지 않는다)
EXPO_PUBLIC_DEV_SESSION=
# 소셜 로그인(결정 034). 공급자 콘솔의 값이고 비밀이 아니다(앱에 들어간다). 값은 .env 에만 적는다.
# 구글: 웹 OAuth 클라이언트 ID(웹 버튼과 앱의 ID 토큰 대상), iOS OAuth 클라이언트 ID(iOS URL scheme)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# 애플: 웹 로그인용 Services ID(iOS 앱은 번들 ID 를 쓰므로 필요 없다)
EXPO_PUBLIC_APPLE_SERVICES_ID=
# 카카오: REST API 키(웹 인가 요청의 client_id), 네이티브 앱 키(앱 SDK)
EXPO_PUBLIC_KAKAO_REST_API_KEY=
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
# 이 앱의 웹 주소(끝에 / 없이). 공유 링크 <웹 주소>/s/<공유 식별자> 를 만들 때 쓴다. 없으면 웹에서는 지금 주소를 쓰고, 앱에서는 링크 버튼을 누를 수 없다
EXPO_PUBLIC_WEB_URL=

{
  "cli": {
    "version": ">= 27.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "test": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "test"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production"
      }
    }
  },
  "submit": {
    "test": {
      "ios": {
        "bundleIdentifier": "com.byeolmyeong.app.test",
        "appName": "별명 테스트",
        "language": "ko"
      }
    },
    "production": {
      "ios": {
        "bundleIdentifier": "com.byeolmyeong.app",
        "appName": "별명",
        "language": "ko"
      }
    }
  }
}

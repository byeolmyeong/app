{
  "expo": {
    "name": "별명",
    "slug": "byeolmyeong",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "byeolmyeong",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.byeolmyeong.app",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.byeolmyeong.app",
      "adaptiveIcon": {
        "backgroundColor": "#0D0E12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.READ_EXTERNAL_STORAGE", "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-router",
        {
          "sitemap": false,
          "asyncRoutes": {
            "web": "development"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0E12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "별명은 사진을 읽지 않아요. 공유 카드를 사진 앱에 저장할 때만 써요.",
          "savePhotosPermission": "공유 카드를 사진 앱에 저장하려고 해요.",
          "granularPermissions": []
        }
      ],
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": "별명은 녹음하지 않아요. 음악을 틀 때 쓰는 소리 기능에 붙은 설정이에요.",
          "enableBackgroundPlayback": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "05ea3dcf-a78c-41f2-b4dc-e819760a054b"
      }
    },
    "owner": "monkeygardens-team"
  }
}
